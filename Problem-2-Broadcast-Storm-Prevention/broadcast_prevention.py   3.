"""
Broadcast Storm Prevention using Ryu SDN Controller.

Detects excessive broadcast traffic from a source MAC address
and installs an OpenFlow rule to block further broadcasts from it.
"""

from ryu.base import app_manager
from ryu.controller import ofp_event
from ryu.controller.handler import (
    CONFIG_DISPATCHER,
    MAIN_DISPATCHER,
    set_ev_cls
)
from ryu.ofproto import ofproto_v1_3
from ryu.lib.packet import packet, ethernet
from collections import defaultdict, deque
import time


class BroadcastStormPrevention(app_manager.RyuApp):

    OFP_VERSIONS = [ofproto_v1_3.OFP_VERSION]

    def __init__(self, *args, **kwargs):
        super(BroadcastStormPrevention, self).__init__(
            *args, **kwargs
        )

        self.mac_table = {}

        # Store broadcast timestamps for each source MAC.
        self.broadcast_history = defaultdict(deque)

        # More than 10 broadcasts within 2 seconds triggers blocking.
        self.threshold = 10
        self.time_window = 2

        self.logger.info("Broadcast Storm Prevention Controller Started")

    def add_flow(self, datapath, priority, match, actions,
                  idle_timeout=0):

        ofproto = datapath.ofproto
        parser = datapath.ofproto_parser

        instructions = [
            parser.OFPInstructionActions(
                ofproto.OFPIT_APPLY_ACTIONS,
                actions
            )
        ]

        flow_mod = parser.OFPFlowMod(
            datapath=datapath,
            priority=priority,
            match=match,
            instructions=instructions,
            idle_timeout=idle_timeout
        )

        datapath.send_msg(flow_mod)

    @set_ev_cls(ofp_event.EventOFPSwitchFeatures, CONFIG_DISPATCHER)
    def switch_features_handler(self, ev):

        datapath = ev.msg.datapath
        ofproto = datapath.ofproto
        parser = datapath.ofproto_parser

        # Table-miss rule: send unmatched packets to the controller.
        match = parser.OFPMatch()

        actions = [
            parser.OFPActionOutput(
                ofproto.OFPP_CONTROLLER,
                ofproto.OFPCML_NO_BUFFER
            )
        ]

        self.add_flow(
            datapath,
            priority=0,
            match=match,
            actions=actions
        )

        self.logger.info(
            "Switch connected: %s",
            datapath.id
        )

    @set_ev_cls(ofp_event.EventOFPPacketIn, MAIN_DISPATCHER)
    def packet_in_handler(self, ev):

        msg = ev.msg
        datapath = msg.datapath

        ofproto = datapath.ofproto
        parser = datapath.ofproto_parser

        dpid = datapath.id
        in_port = msg.match['in_port']

        pkt = packet.Packet(msg.data)
        eth = pkt.get_protocol(ethernet.ethernet)

        if eth is None:
            return

        src = eth.src
        dst = eth.dst

        # Ignore LLDP packets.
        if eth.ethertype == 0x88cc:
            return

        # Initialize MAC learning table for the switch.
        self.mac_table.setdefault(dpid, {})

        # Learn the source MAC address.
        self.mac_table[dpid][src] = in_port

        # Check whether the packet is a broadcast frame.
        if dst == 'ff:ff:ff:ff:ff:ff':

            current_time = time.monotonic()

            history = self.broadcast_history[src]

            # Remove timestamps outside the monitoring window.
            while (
                history
                and current_time - history[0] > self.time_window
            ):
                history.popleft()

            # Record the current broadcast packet.
            history.append(current_time)

            self.logger.info(
                "Broadcast detected from %s | Count: %d",
                src,
                len(history)
            )

            # Detect a broadcast storm.
            if len(history) > self.threshold:

                self.logger.warning(
                    "BROADCAST STORM DETECTED from %s",
                    src
                )

                # Match broadcast packets from the detected source.
                match = parser.OFPMatch(
                    in_port=in_port,
                    eth_src=src,
                    eth_dst='ff:ff:ff:ff:ff:ff'
                )

                # Empty action list means drop matching packets.
                self.add_flow(
                    datapath,
                    priority=300,
                    match=match,
                    actions=[],
                    idle_timeout=10
                )

                self.logger.warning(
                    "Broadcast traffic blocked from %s",
                    src
                )

                return

            # Forward normal broadcast packets to all ports.
            actions = [
                parser.OFPActionOutput(ofproto.OFPP_FLOOD)
            ]

        else:

            # Check whether the destination MAC is already known.
            if dst in self.mac_table[dpid]:

                out_port = self.mac_table[dpid][dst]

                actions = [
                    parser.OFPActionOutput(out_port)
                ]

                # Install a forwarding rule for known destinations.
                match = parser.OFPMatch(
                    in_port=in_port,
                    eth_src=src,
                    eth_dst=dst
                )

                self.add_flow(
                    datapath,
                    priority=10,
                    match=match,
                    actions=actions,
                    idle_timeout=30
                )

            else:

                # Flood packets when destination MAC is unknown.
                actions = [
                    parser.OFPActionOutput(ofproto.OFPP_FLOOD)
                ]

        # Send the packet through the selected output action.
        out = parser.OFPPacketOut(
            datapath=datapath,
            buffer_id=ofproto.OFP_NO_BUFFER,
            in_port=in_port,
            actions=actions,
            data=msg.data
        )

        datapath.send_msg(out)
